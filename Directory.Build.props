<Project>
  <PropertyGroup>
    <UseScryberProjRef>True</UseScryberProjRef>
  </PropertyGroup>

  <!-- Shared by both packages in this repo, so they version together.
       AssemblyVersion is authoritative and the other two derive from it, which is also what the
       release workflow reads via "dotnet msbuild -getProperty:AssemblyVersion". -->
  <PropertyGroup>
    <AssemblyVersion>1.26.235.1</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <VersionPrefix>$(AssemblyVersion)</VersionPrefix>
    <Company>Two Fat Monkeys</Company>
    <RepositoryUrl>https://github.com/twofatmonkeys/TFM.Scryber.Core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
